FROM node:20-bookworm-slim AS builder

# Prisma precisa de openssl em muitos ambientes
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) Copia package primeiro
COPY package*.json ./

# 2) Copia prisma ANTES do npm ci (porque postinstall pode chamar prisma generate)
COPY prisma ./prisma

# 3) Instala deps sem rodar scripts (evita prisma generate sem schema completo)
RUN npm ci --ignore-scripts

# 4) Agora roda prisma generate explicitamente
RUN npx prisma generate

# 5) Copia o resto do código e builda
COPY . .
RUN npm run build

# ---- runtime ----
FROM node:20-bookworm-slim AS runner
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app /app

EXPOSE 3000
CMD ["npm","run","start"]